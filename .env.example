# Alpaca credentials stay on the server. Never prefix these with NEXT_PUBLIC_.
ALPACA_API_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Used by the web process. The autonomous runner always uses paper execution.
ALPACA_EXECUTION_ENABLED=false

# Official Alpaca CLI used by the autonomous runner for paper order execution.
# On macOS/Linux this can simply be `alpaca` when the CLI is on PATH.
ALPACA_CLI_PATH=.tools/alpaca/alpaca.exe
ALPACA_EXPECTED_ACCOUNT_ID=
ALPACA_MIN_OPTIONS_LEVEL=2

# Autonomous local runner. The dashboard must be running at this address.
LOCAL_DASHBOARD_URL=http://localhost:3000
AGENT_SCAN_TIMEFRAME=1Hour
AGENT_SCAN_LOOKBACK_BARS=100
AGENT_SCAN_FREQUENCY_MINUTES=60
AGENT_SCAN_DELAY_MINUTES=2
AGENT_SCAN_MAXIMUM_LATENESS_MINUTES=5
AGENT_SIGNAL_TTL_MINUTES=55

# Optional canonical deployment URL used for social preview metadata.
SITE_URL=http://localhost:3000
