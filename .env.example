# Alpaca credentials stay on the server. Never prefix these with NEXT_PUBLIC_.
ALPACA_API_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Used by the web process. The autonomous runner always uses paper execution.
ALPACA_EXECUTION_ENABLED=false

# Official Alpaca CLI used by the autonomous runner for paper order execution.
# On macOS/Linux this can simply be `alpaca` when the CLI is on PATH.
ALPACA_CLI_PATH=.tools/alpaca/alpaca.exe
ALPACA_EXPECTED_ACCOUNT_ID=
ALPACA_MIN_OPTIONS_LEVEL=2

# Autonomous local runner. The dashboard must be running at this address.
LOCAL_DASHBOARD_URL=http://localhost:3000
LOCAL_RUNNER_CONTROL_URL=http://127.0.0.1:4318
LOCAL_RUNNER_CONTROL_PORT=4318
AUTONOMOUS_RUNNER_AUTO_START=false
# A strategy can analyze while this remains false. Set true only after binding
# ALPACA_EXPECTED_ACCOUNT_ID to the intended paper account.
AUTONOMOUS_EXECUTION_ENABLED=false
TECHNICAL_STRATEGY_ENABLED=false
AGENT_SCAN_TIMEFRAME=1Hour
AGENT_SCAN_LOOKBACK_BARS=100
AGENT_SCAN_FREQUENCY_MINUTES=60
AGENT_SCAN_DELAY_MINUTES=2
AGENT_SCAN_MAXIMUM_LATENESS_MINUTES=5
AGENT_SIGNAL_TTL_MINUTES=55

# Local SQLite ledger for technical and news decisions.
AGENT_DECISION_DB_PATH=.data/agent-decisions.sqlite

# Independent low-frequency news strategy. Enabled state and tracked symbols
# are managed from the local dashboard configuration.
NEWS_STRATEGY_ENABLED=false
NEWS_SYMBOLS=NVDA,AAPL,MSFT,AMZN,META
NEWS_STRATEGY_FREQUENCY_MINUTES=300
NEWS_LOOKBACK_HOURS=24
NEWS_SIGNAL_TTL_MINUTES=300
NEWS_LIMIT_PER_SYMBOL=10
NEWS_MINIMUM_CONFIDENCE=0.65
NEWS_MINIMUM_RELEVANCE=0.60
NEWS_MINIMUM_IMPACT=medium

# Free local model through Ollama. qwen3:8b is the default and can be replaced.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=qwen3:8b
ALPACA_MCP_COMMAND=uvx
ALPACA_MCP_PACKAGE=alpaca-mcp-server
COPILOT_PROPOSAL_TTL_MINUTES=10
OLLAMA_TIMEOUT_MS=300000

# Public demo. Without a token, public:demo creates a temporary Quick Tunnel.
# A named Cloudflare Tunnel token provides a stable hostname.
CLOUDFLARED_PATH=.tools/cloudflared/cloudflared.exe
CLOUDFLARED_TUNNEL_TOKEN=

# Optional secondary sources. Alpaca, Google News RSS, and configured company
# feeds work without these extra keys. GDELT is opt-in because its public
# endpoint can be slow.
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=
GDELT_NEWS_ENABLED=false

# Optional canonical deployment URL used for social preview metadata.
SITE_URL=http://localhost:3000
